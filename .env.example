# ==========================================
# VectraBase AI — Environment Variables
# Copy this file to .env in each app directory
# ==========================================

# ---- apps/api-gateway/.env ----
DATABASE_URL=postgresql://vectrabase:vectrabase_secret@localhost:5432/vectrabase_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_min_32_chars_here_replace_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_replace_in_production
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- apps/rag-engine/.env ----
DATABASE_URL=postgresql://vectrabase:vectrabase_secret@localhost:5432/vectrabase_db
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama-3.3-70b-versatile

# ---- apps/web-dashboard/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RAG_URL=http://localhost:8000
NEXT_PUBLIC_WIDGET_URL=http://localhost:5173
NEXT_PUBLIC_APP_NAME=VectraBase AI

# ---- apps/embed-widget/.env ----
VITE_API_URL=http://localhost:4000
VITE_RAG_URL=http://localhost:8000

# ---- Production overrides (Neon + Upstash) ----
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/vectrabase_db?sslmode=require
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6380

